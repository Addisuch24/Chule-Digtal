<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Default: Cleartext HTTP is strictly prohibited. HTTPS is enforced. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Local Development / Testing Exceptions:
         Permitted only for Android Emulator host and verified local development subnets. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">192.168.137.176</domain>
        <domain includeSubdomains="true">192.168.188.3</domain>
        <domain includeSubdomains="true">10.232.82.104</domain>
    </domain-config>
</network-security-config>
