# ==============================================================================
# Chule Digita Web Client Environment Configuration Example
# Copy this file to '.env.production' or '.env.local'.
# Note: Vite exposes all variables prefixed with 'VITE_' publicly to the browser bundle.
# NEVER place secret API keys or database passwords here.
# ==============================================================================

# Production Backend REST API Base URL (Must use HTTPS in production)
VITE_API_URL=https://api.chuledigital.com/api

# Production Socket.IO Server URL (Must use WSS/HTTPS in production)
VITE_SOCKET_URL=https://api.chuledigital.com
