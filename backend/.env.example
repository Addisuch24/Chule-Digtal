# ==============================================================================
# Chule Digita Backend Environment Configuration Example
# Copy this file to '.env' and populate with your environment-specific credentials.
# NEVER commit the real '.env' file to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Supabase PostgreSQL 17)
# Option 1: Direct parameters
PGHOST=db.your-supabase-project.supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_database_password_here
PGDATABASE=postgres

# Option 2: Connection URL / Pooler URL
# DATABASE_URL=postgresql://postgres.your-project:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# TLS Root Certificate (Optional path, defaults to certs/prod-ca-2021.crt)
# PGSSLROOTCERT=certs/prod-ca-2021.crt

# Security & Authentication
# Generate a secure 256-bit secret using: openssl rand -hex 32
# In production, startup will fail if this is empty, short (<32 chars), or set to default placeholder.
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Allowed Cross-Origin Resource Sharing (CORS) Origins
# In production, wildcard '*' is strictly forbidden. Provide comma-separated list of trusted web domains:
CORS_ORIGIN=https://app.chuledigital.com,https://admin.chuledigital.com

# Firebase Cloud Messaging (Optional - for OS background push delivery)
# Path to service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
